#!/usr/bin/env python
"""
Pull bounded position history for a specific pubkey

Usage:
    position_history --account <target_pubkey>
"""

import argparse
import json
from dataclasses import asdict

from bulk_api import BulkHttpClient



def position_history(
    account: str,
    url: str,
    n: int,
) -> list:
    """
    Load account info
    """
    if n <= 0:
        return []
    client = BulkHttpClient(base_url=url)
    rows = []
    cursor = None
    seen_cursors = set()
    while len(rows) < n:
        page = client.get_positions_page(
            account,
            limit=min(500, n - len(rows)),
            cursor=cursor,
        )
        if not page.data:
            break
        rows.extend(page.data[:n - len(rows)])
        if page.page.next_cursor is None:
            break
        if page.page.next_cursor in seen_cursors:
            raise RuntimeError(f"repeated history cursor: {page.page.next_cursor}")
        seen_cursors.add(page.page.next_cursor)
        cursor = page.page.next_cursor
    return rows


def main():
    """Main entry point for the application"""
    # Setup argument parser
    parser = argparse.ArgumentParser(
        description='Pull position history for a specific pubkey',
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )

    parser.add_argument(
        '--account',
        type=str,
        required=True,
        help='account to query (base58)'
    )

    parser.add_argument(
        '--n',
        type=int,
        required=False,
        default=100,
        help='indicate how many positions to list'
    )

    parser.add_argument(
        '--url',
        type=str,
        default='https://exchange-api2.bulk.trade/api/v1',
        help='API base URL (default: testnet URL)'
    )

    args = parser.parse_args()

    result = position_history(account=args.account, url=args.url, n=args.n)
    js = json.dumps([asdict(row) for row in result], indent=2)
    print(js)


if __name__ == "__main__":
    main()
