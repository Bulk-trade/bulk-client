{
    // coin to be MM (will be rendered to proper bulk symbol)
    coin: "BTC",
    // API (for testnet: "wss://exchange-wss.bulk.trade")
    url: "ws://localhost:12001",
    // indicate whether should track order changes
    track_orders: true,

    // base price
    price: 100000.0,
    // mean reversion constant (for example 0.0001)
    kappa: 0.0001,
    // standard deviation (for example 0.01)
    sigma: 0.1,

    // spread to offer at
    spread: 0.10,
    // base size of inner level
    size: 0.1,
    // depth of book on each side (for example 500)
    depth: 500,
    // orders per level (for example 20)
    orders_per_level: 20,
    // chunk size
    chunksize: 15000,

    // frequency of update (secs)
    frequency: 0.005,
    // priming period
    priming: 20,
    // timeout period in seconds (change this to adjust amount of time a query can take)
    timeout: 10
}
