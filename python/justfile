
# Default recipe (runs when you just type 'just')
default:
    @just --list

# Install both packages in editable mode
install:
    pip install -e api/
    pip install -e mm/

# Build both packages
build:
    cd api && hatch build
    cd mm && hatch build

# Clean build artifacts
clean:
    rm -rf api/dist api/build api/*.egg-info
    rm -rf mm/dist mm/build mm/*.egg-info

# Run mm with hot reload during development
run:
    cd mm && python -m mm

# Format code in both packages
fmt:
    cd api && hatch fmt
    cd mm && hatch fmt
