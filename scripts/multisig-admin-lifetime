#!/usr/bin/env bash

set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(cd -- "${SCRIPT_DIR}/.." && pwd)"
source "${SCRIPT_DIR}/include/common.sh"

usage() {
  cat >&2 <<EOF
Usage: $0 <lifetime-seconds> [-ledger] [-url <api-url>] [-net <mainnet|testnet|devnet|local>]

Proposes updating the admin multisig's proposal lifetime.
Lifetime is required in seconds (172800 = 48 hours). Requires multisig approval and execution.
EOF
}

bulk_admin_parse_common_args "$@"
set -- ${BULK_ADMIN_ARGS[@]+"${BULK_ADMIN_ARGS[@]}"}

if (( $# != 1 )); then
  echo "error: multisig-admin-lifetime requires one lifetime in seconds" >&2
  usage
  exit 2
fi

lifetime="$1"
if [[ ! "${lifetime}" =~ ^[0-9]+$ ]]; then
  echo "error: lifetime must be an integer number of seconds" >&2
  exit 2
fi

bulk_admin_run update-multisig ADM1N11111111111111111111111111111111113D --lifetime "${lifetime}"
